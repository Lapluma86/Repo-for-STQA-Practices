        - text: "103"
        - text: "92"
        - text: "0"
        - text: "11"
        - text: 89.3%
      - - text: 最小集成
          align: [left, middle]
        - text: "1"
        - text: "1"
        - text: "0"
        - text: "0"
        - text: 100%
      - - text: 合计
          align: [left, middle]
        - text: "199"
        - text: "188"
        - text: "0"
        - text: "11"
        - text: 94.5%
  - elementId: report-img
    elementType: image
    bounds: [500, 196, 412, 218]
    src: media/report_module1.png
    fit: {mode: cover}
    crop: {right: 0.28, bottom: 0.32}
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: report-caption
    elementType: text
    bounds: [500, 418, 412, 32]
    content:
      style: "$small"
      text: 图 2　pytest-html 基线报告摘要（2026-09-15 模块一独立执行；Summary 中 188 为未跳过的实际执行数）。
  - elementId: result-note
    elementType: text
    bounds: [48, 452, 864, 44]
    content:
      style: "$footnote"
      text: 运行环境：Windows 11 · i5-12500H · 16 GB · Python 3.10.20 · PyTorch 2.12.0+cpu · pytest 9.1.1。收集总数 199 以 JUnit 与日志为准；11 项跳过均为 CUDA 相关，不计为通过。
  - elementId: frule
    elementType: shape
    bounds: [48, 508, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: fleft
    elementType: text
    bounds: [48, 514, 400, 14]
    content: {fontSize: 9, color: "$muted", wrap: false, text: 软件测试与质量保证实践 · 模块一成果汇报}
  - elementId: fright
    elementType: text
    bounds: [812, 514, 100, 14]
    content: {fontSize: 9, color: "$muted", align: [right, top], wrap: false, text: "07 / 12"}
