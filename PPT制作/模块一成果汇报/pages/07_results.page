    fill: {type: solid, color: "$hairline"}
  - elementId: stat2-num
    elementType: text
    bounds: [232, 110, 150, 48]
    content: {fontSize: 36, bold: true, color: "$pass", fontFamily: {latin: "Liter", ea: "MiSans"}, wrap: false, text: "188"}
  - elementId: stat2-label
    elementType: text
    bounds: [232, 160, 150, 16]
    content: {fontSize: 10, color: "$muted", wrap: false, text: 通过（项）}
  - elementId: stat2-sep
