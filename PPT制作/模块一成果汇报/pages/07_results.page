pageType: content
background:
  type: solid
  color: "$bodybg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 26, 400, 18]
    content: {style: "$kicker", wrap: false, text: "04 · 结果 · 覆盖率 · 缺陷"}
  - elementId: title
    elementType: text
    bounds: [48, 46, 720, 34]
    content: {style: "$pagetitle", wrap: false, text: 执行结果：199 项收集，188 通过，0 失败}
  - elementId: secnum
    elementType: text
    bounds: [832, 22, 80, 38]
    content: {fontSize: 28, bold: true, color: "$soft", align: [right, middle], wrap: false, text: "04"}
  - elementId: hrule
    elementType: shape
    bounds: [48, 92, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: hrule-accent
    elementType: shape
    bounds: [48, 90, 56, 2]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: stat1-num
    elementType: text
    bounds: [48, 110, 150, 48]
    content: {fontSize: 36, bold: true, color: "$ink", fontFamily: {latin: "Liter", ea: "MiSans"}, wrap: false, text: "199"}
  - elementId: stat1-label
    elementType: text
    bounds: [48, 160, 150, 16]
    content: {fontSize: 10, color: "$muted", wrap: false, text: 收集用例（项）}
