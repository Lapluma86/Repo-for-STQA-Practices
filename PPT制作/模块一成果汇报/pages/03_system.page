pageType: content
background:
  type: solid
  color: "$bodybg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 26, 400, 18]
    content: {style: "$kicker", wrap: false, text: "01 · 被测对象"}
  - elementId: title
    elementType: text
    bounds: [48, 46, 720, 34]
    content: {style: "$pagetitle", wrap: false, text: 被测系统：钢轨表面缺陷双模态检测}
  - elementId: secnum
    elementType: text
    bounds: [832, 22, 80, 38]
    content: {fontSize: 28, bold: true, color: "$soft", align: [right, middle], wrap: false, text: "01"}
  - elementId: hrule
    elementType: shape
    bounds: [48, 92, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: hrule-accent
    elementType: shape
    bounds: [48, 90, 56, 2]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: b1-label
    elementType: text
    bounds: [48, 112, 392, 20]
    content: {fontSize: 12, bold: true, color: "$accent", wrap: false, text: 检测任务}
  - elementId: b1-text
    elementType: text
    bounds: [48, 134, 392, 66]
    content:
      style: "$body"
      text: 对已部署的钢轨视觉系统做表面缺陷检测：输入 Intensity（光强）与 Depth（深度）双模态图像，识别裂纹、剥落、掉块等缺陷，输出异常图与图像级异常分数。
  - elementId: b1-line
    elementType: shape
    bounds: [48, 210, 392, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: b2-label
    elementType: text
    bounds: [48, 224, 392, 20]
    content: {fontSize: 12, bold: true, color: "$accent", wrap: false, text: 技术路线（TRD 反向蒸馏）}
  - elementId: b2-text
    elementType: text
    bounds: [48, 246, 392, 66]
    content:
      style: "$body"
      text: RGB/Intensity 与 Depth 两路教师网络提取多尺度特征，学生解码器重建教师特征，以特征差异定位异常；教师主干冻结，异常分数用于图像级判定。
  - elementId: b2-line
    elementType: shape
    bounds: [48, 322, 392, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: b3-label
    elementType: text
    bounds: [48, 336, 392, 20]
    content: {fontSize: 12, bold: true, color: "$accent", wrap: false, text: 为什么必须系统测试}
  - elementId: b3-text
    elementType: text
    bounds: [48, 358, 392, 130]
    content:
      style: "$body"
      text: |
        <p>· 安全关键：误报与漏检直接影响铁路运维决策；</p>
        <p>· 数据管线环节多：双模态配对、采样划分、patch 裁剪、归一化，任一环节错位都会静默污染结果；</p>
        <p>· 数值密集：损失与指标代码的细微错误不报错，却会改变训练与评估结论。</p>
  - elementId: samples-img
    elementType: image
    bounds: [472, 112, 440, 330]
    src: media/dataset_samples.png
    fit: {mode: contain}
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: samples-caption
    elementType: text
    bounds: [472, 448, 440, 40]
    content:
      style: "$small"
      text: 图 1　钢轨双模态数据集示例：Cam1 / Cam4 / Cam5 三个视角的 Intensity 与 Depth 图像（上排正常、下排异常）。来源：被测项目答辩材料。
  - elementId: frule
    elementType: shape
    bounds: [48, 508, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: fleft
    elementType: text
    bounds: [48, 514, 400, 14]
    content: {fontSize: 9, color: "$muted", wrap: false, text: 软件测试与质量保证实践 · 模块一成果汇报}
  - elementId: fright
    elementType: text
    bounds: [812, 514, 100, 14]
    content: {fontSize: 9, color: "$muted", align: [right, top], wrap: false, text: "03 / 12"}
