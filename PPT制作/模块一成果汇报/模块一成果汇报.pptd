version: v2
title: 钢轨表面缺陷检测系统的测试基础实践 —— 模块一成果汇报
size: [960, 540]
customFonts:
  - family: Liter
    src: "https://statics.kimi.ai/neo-design-static/p-font/Liter.ttf"
  - family: JetBrains Mono
    src: "https://fonts.googleapis.com/css2?family=JetBrains+Mono"
theme:
  colors:
    ink: "#26313B"
    primary: "#31495C"
    accent: "#C05F21"
    paper: "#F5F2EB"
    bodybg: "#FBFAF7"
    muted: "#6E747A"
    hairline: "#D9D4C9"
    soft: "#EAE6DC"
    pass: "#35705B"
    fail: "#A63D2F"
  textStyles:
    kicker:
      fontSize: 11
      color: "$accent"
      bold: true
      letterSpacing: 2
      fontFamily: {latin: "Liter", ea: "MiSans"}
    pagetitle:
      fontSize: 25
      color: "$ink"
      bold: true
    body:
      fontSize: 13
      color: "$ink"
      lineHeight: 1.5
    small:
      fontSize: 10
      color: "$muted"
      lineHeight: 1.4
    footnote:
      fontSize: 9
      color: "$muted"
      lineHeight: 1.4
  tableStyles:
    three:
      cellStyle:
        fontSize: 11
        color: "$ink"
        border: null
        align: [center, middle]
        lineHeight: 1.3
      firstRowStyle:
        bold: true
        color: "$ink"
        border:
          - {style: solid, width: 2, color: "$ink"}
          - null
          - {style: solid, width: 1, color: "$ink"}
          - null
      lastRowStyle:
        bold: true
        border:
          - null
          - null
          - {style: solid, width: 2, color: "$ink"}
          - null
      bodyStyles:
        - border:
            - null
            - null
            - {style: solid, width: 1, color: "$hairline"}
            - null
pages:
  - pages/01_cover.page
  - pages/02_toc.page
  - pages/03_system.page
  - pages/04_scope.page
  - pages/05_strategy.page
  - pages/06_automation.page
  - pages/07_results.page
  - pages/08_coverage.page
  - pages/09_defect.page
  - pages/10_defects.page
  - pages/11_conclusion.page
  - pages/12_team.page
